# Atlas URI (prefer default database in URI path; DB_NAME below should match logical app DB)
MONGO_DETAILS=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority&appName=EventThon
DB_NAME=EventThon_Network
# If login/profile calls "hang" then work after ~30s: Mongo is not reachable (VPN, wrong password, IP not whitelisted on Atlas).
# Optional: fail faster (milliseconds)
# MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
# MONGO_CONNECT_TIMEOUT_MS=8000
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Optional: powers Post Wizard "AI Enhance" (falls back to local polish if empty)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
ADMIN_OTP=change_me_secure_admin_otp
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://eventthone.com,https://eventthone.com,http://www.eventthone.com,https://www.eventthone.com
# Gmail SMTP — authenticate with the same account shown to recipients
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=eventthon@gmail.com
SMTP_PASSWORD=your_gmail_app_password_for_eventthon
# Public sender shown in outgoing emails (must match SMTP_USER for Gmail)
MAIL_FROM=eventthon@gmail.com
MAIL_FROM_NAME=EventThon Network
# IMAP inbox polling for reply tracking (uses same SMTP_USER / SMTP_PASSWORD)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Local Ollama LLM for AI Auto-Responder (Email Outreach)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SEC=120

# --- Payment Gateway (Stripe / LemonSqueezy) ---
PAYMENT_MODE=test
PAYMENT_GATEWAY=stripe
THON_PER_USD=100
PAYMENT_HOLD_HOURS=48
PAYMENT_SETTLEMENT_INTERVAL_SEC=3600
PAYMENT_SUCCESS_URL=http://localhost:3000/wallet?deposit=success
PAYMENT_CANCEL_URL=http://localhost:3000/wallet?deposit=cancelled
# Optional: protect mock webhook in test (header X-Mock-Webhook-Secret)
MOCK_WEBHOOK_SECRET=change_me_mock_webhook_secret
# Rate limits (requests per minute per IP)
RATE_LIMIT_AUTH_PER_MIN=40
RATE_LIMIT_FINANCE_PER_MIN=80
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...
# STRIPE_LIVE_SECRET_KEY=sk_live_...
# STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_LIVE_WEBHOOK_SECRET=whsec_...
LEMONSQUEEZY_TEST_API_KEY=
LEMONSQUEEZY_TEST_STORE_ID=
LEMONSQUEEZY_TEST_VARIANT_ID=
LEMONSQUEEZY_TEST_WEBHOOK_SECRET=
